    },
    "B05": {
      "title": "Seeded watershed",
      "hypothesis": "Flood the converted-image gradient from sparse original tile-center seeds; all pixels participate."
    },
    "B08": {
      "title": "Finite-range CRF",
      "hypothesis": "Mean-field posterior inference with contrast-weighted messages at three physical neighborhood radii."
    },
    "B09": {
      "title": "Geodesic competition",
      "hypothesis": "Each coarse class expands along minimum cumulative appearance/edge travel cost; competing geodesic distances select the label."
    },
    "B10": {
      "title": "Convex total-variation partition",
      "hypothesis": "Primal-dual optimization of a simplex-valued class field with appearance fidelity and isotropic TV regularity."
    },
    "B12": {
      "title": "Hierarchical region merging",
      "hypothesis": "Agglomerate adjacent image regions by adaptive mean-color distance while preventing conflicting coarse-anchor mergers."
    },
    "B19": {
      "title": "Retained-solver consensus",
      "hypothesis": "Equal votes from B02 appearance, B05 watershed, B09 geodesic and B10 TV; appearance resolves ties. Revised membership after rejected solvers were removed."
    }
